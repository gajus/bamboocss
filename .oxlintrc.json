{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "plugins": ["typescript"],
  "ignorePatterns": [
    "**/*.d.ts",
    "**/*.js",
    "**/*.cjs",
    "**/*.mjs",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/styled-system/**",
    "**/*-outdir/**",
    "**/outdir/**",
    "**/__golden__/**",
    // These test bamboo's support for tsconfig `baseUrl`, which TypeScript 7 removed, so the
    // type-aware linter refuses their tsconfigs outright.
    "packages/config/__tests__/samples/with-tsconfig-paths/**",
    "packages/node/__tests__/fixtures/solution-mixed/**"
  ],
  // Type information reaches the rules through `oxlint-tsgolint`: a hook called without waiting
  // for it reads as a statement like any other without it, and one went unseen that way.
  "options": {
    "typeAware": true
  },
  "env": {
    "node": true,
    "browser": true
  },
  "rules": {
    "no-prototype-builtins": "off",
    "typescript/no-explicit-any": "off",
    "typescript/no-non-null-assertion": "off",
    "typescript/ban-ts-comment": "off",
    "typescript/no-require-imports": "off",
    "typescript/no-wrapper-object-types": "off",
    "no-unused-expressions": "off",
    "no-unassigned-vars": "off",
    "no-unsafe-optional-chaining": "off",
    "typescript/no-unnecessary-parameter-property-assignment": "off",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    // Type-aware rules `correctness` turns on. When type information came in, they found nothing
    // that went wrong at runtime here, and mostly what was not there: a method signature
    // destructured or passed whole, a `never` in an exhaustive switch's message, a value typed
    // `{}` by a generic's default. `no-implied-eval` is the tests running the code they generate.
    "typescript/unbound-method": "off",
    "typescript/no-implied-eval": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-duplicate-type-constituents": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/no-useless-default-assignment": "off",
    "typescript/no-misused-spread": "off",
    "typescript/no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/*/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:assert|async_hooks|buffer|child_process|cluster|console|constants|crypto|dgram|diagnostics_channel|dns|domain|events|fs|http|http2|https|inspector|module|net|os|path|perf_hooks|process|punycode|querystring|readline|repl|stream|string_decoder|sys|timers|tls|trace_events|tty|url|util|v8|vm|wasi|worker_threads|zlib)(?:/.*)?$",
                "message": "Import a Node built-in with the `node:` prefix: the published dist keeps the specifier, and Deno resolves no other."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/shared/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:node:.*|(?:assert|async_hooks|buffer|child_process|cluster|console|constants|crypto|dgram|diagnostics_channel|dns|domain|events|fs|http|http2|https|inspector|module|net|os|path|perf_hooks|process|punycode|querystring|readline|repl|stream|string_decoder|sys|timers|tls|trace_events|tty|url|util|v8|vm|wasi|worker_threads|zlib)(?:/.*)?)$",
                "message": "Code in @bamboocss/shared can end up in styled-system/helpers.mjs, which runs in the browser: import no Node built-in here, with or without `node:`."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "process",
            "message": "Code in @bamboocss/shared can end up in styled-system/helpers.mjs, which runs in the browser."
          },
          {
            "name": "Buffer",
            "message": "Code in @bamboocss/shared can end up in styled-system/helpers.mjs, which runs in the browser."
          },
          {
            "name": "global",
            "message": "Code in @bamboocss/shared can end up in styled-system/helpers.mjs, which runs in the browser."
          },
          {
            "name": "require",
            "message": "Code in @bamboocss/shared can end up in styled-system/helpers.mjs, which runs in the browser."
          },
          {
            "name": "__dirname",
            "message": "Code in @bamboocss/shared can end up in styled-system/helpers.mjs, which runs in the browser."
          },
          {
            "name": "__filename",
            "message": "Code in @bamboocss/shared can end up in styled-system/helpers.mjs, which runs in the browser."
          }
        ]
      }
    }
  ]
}
