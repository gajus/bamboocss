{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@changesets/changelog-github", "@projectwallace/format-css"]
    },
    "packages/cli": {
      "entry": ["src/cli-default.ts!"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@bamboocss/token-dictionary"]
    },
    "packages/config": {
      "project": ["src/**/*.ts"],
      "ignore": ["__tests__/**"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["browserslist"]
    },
    "packages/extractor": {
      "project": ["src/**/*.ts"]
    },
    "packages/fixture": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@bamboocss/token-dictionary", "postcss"]
    },
    "packages/generator": {
      "project": ["src/**/*.ts"]
    },
    "packages/is-valid-prop": {
      "project": ["src/**/*.ts"]
    },
    "packages/logger": {
      "project": ["src/**/*.ts"]
    },
    "packages/mcp": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@bamboocss/types"]
    },
    "packages/node": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@bamboocss/token-dictionary", "lodash.merge", "pkg-types", "pluralize", "ts-pattern"]
    },
    "packages/parser": {
      "project": ["src/**/*.ts"]
    },
    "packages/preset-atlaskit": {
      "project": ["src/**/*.ts"]
    },
    "packages/preset-bamboo": {
      "project": ["src/**/*.ts"]
    },
    "packages/preset-base": {
      "project": ["src/**/*.ts"]
    },
    "packages/preset-open-props": {
      "project": ["src/**/*.ts"]
    },
    "packages/reporter": {
      "project": ["src/**/*.ts"]
    },
    "packages/shared": {
      "entry": ["src/shared.ts!"],
      "project": ["src/**/*.ts"]
    },
    "packages/token-dictionary": {
      "project": ["src/**/*.ts"]
    },
    "packages/vite": {
      "project": ["src/**/*.ts"]
    },
    "packages/types": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["csstype", "ts-morph"]
    },
    "packages/plugin-lightningcss": {
      "project": ["src/**/*.ts"]
    },
    "packages/plugin-svelte": {
      "project": ["src/**/*.ts"]
    },
    "website": {
      "entry": [
        "app/{root,routes}.tsx",
        "app/routes/**/*.{ts,tsx}",
        "velite.config.ts",
        "bamboo.config.ts",
        "seo.config.ts",
        "scripts/*.tsx"
      ],
      "project": ["{app,src,theme,scripts}/**/*.{ts,tsx,cjs,mjs}"],
      "ignore": ["src/icons/**", "src/mdx/contexts/**"]
    },
    "packages/plugin-vue": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreWorkspaces": ["sandbox/*", "sandbox/component-lib/**"],
  "ignoreExportsUsedInFile": true,
  "ignore": ["**/__tests__/**", "bench/vite-cold-import-child.mjs"],
  "exclude": ["duplicates"]
}
