{
  "name": "bamboo",
  "version": "0.0.1",
  "private": true,
  "description": "Build-time, type-safe, zero-runtime CSS-in-JS",
  "keywords": [],
  "license": "MIT",
  "author": "Gajus Kuizinas <gajus@gajus.com>",
  "type": "module",
  "scripts": {
    "prepare": "husky && pnpm build-fast",
    "dev": "pnpm --parallel --filter=./packages/** dev",
    "build-fast": "pnpm -r --parallel --filter=./packages/** build-fast",
    "build": "pnpm -r --filter=./packages/** build",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test run && pnpm test:codegen",
    "clean": "pnpm -r --parallel exec rimraf dist .turbo *.log",
    "reset": "pnpm -r --parallel exec rimraf node_modules && rimraf node_modules",
    "test:import-map": "cd packages/config/__tests__/samples/ts-import-map && pnpm test && cd ../ts-import-map-one-source && pnpm test",
    "test": "vitest",
    "codegen": "pnpm --filter=./sandbox/codegen",
    "test:codegen": "pnpm codegen test && pnpm codegen typecheck",
    "test-watch": "vitest --watch -u",
    "bench": "vitest bench --run --no-file-parallelism",
    "bench:baseline": "vitest bench --run --no-file-parallelism --outputJson=bench/baseline.json",
    "bench:compare": "vitest bench --run --no-file-parallelism --compare=bench/baseline.json",
    "bench:vite-import": "node bench/vite-cold-import.mjs",
    "lint": "oxlint .",
    "knip": "knip",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "release": "changeset publish",
    "release-dev": "changeset version --snapshot dev && changeset publish --tag dev",
    "website": "pnpm --filter=./website",
    "mdx-check": "pnpm --filter=website check-links",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=json --coverage.include='packages/*/src/**'"
  },
  "dependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.29.8",
    "@projectwallace/format-css": "^2.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "chokidar": "5.0.0",
    "cross-env": "10.1.0",
    "happy-dom": "20.0.11",
    "husky": "9.1.7",
    "rimraf": "5.0.10",
    "ts-morph": "28.0.0",
    "tsdown": "0.22.0",
    "tsx": "4.20.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.0.15"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.0.15",
    "knip": "6.14.1",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0"
  },
  "packageManager": "pnpm@11.0.8",
  "pnpm": {
    "overrides": {
      "@swc/helpers@~0.4": "0.4.36",
      "picomatch@4.0.3": "4.0.5"
    }
  }
}
