{
  "name": "@bamboocss/dev",
  "version": "1.51.0",
  "description": "Build-time, type-safe, zero-runtime CSS-in-JS",
  "homepage": "https://bamboocss.com",
  "license": "MIT",
  "author": "Gajus Kuizinas <gajus@gajus.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gajus/bamboocss.git",
    "directory": "packages/cli"
  },
  "bin": {
    "bamboo": "bin.js",
    "bamboocss": "bin.js"
  },
  "files": [
    "dist",
    "bin",
    "app",
    "bin.js",
    "*.d.ts"
  ],
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./presets": {
      "source": "./src/presets.ts",
      "types": "./dist/presets.d.cts",
      "require": "./dist/presets.cjs",
      "import": {
        "types": "./dist/presets.d.mts",
        "default": "./dist/presets.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --dts",
    "build-fast": "tsdown --dts=false",
    "dev": "pnpm build-fast --watch src"
  },
  "dependencies": {
    "@bamboocss/logger": "workspace:*",
    "@bamboocss/node": "workspace:*",
    "@bamboocss/preset-bamboo": "workspace:*",
    "@bamboocss/preset-base": "workspace:*",
    "@bamboocss/shared": "workspace:*",
    "@bamboocss/token-dictionary": "workspace:*",
    "@bamboocss/types": "workspace:*",
    "@clack/prompts": "0.11.0",
    "cac": "6.7.14"
  },
  "devDependencies": {
    "@types/update-notifier": "6.0.8",
    "kleur": "4.1.5",
    "update-notifier": "7.3.1"
  }
}
