{
  "name": "@bamboocss/core",
  "version": "1.47.0",
  "description": "core functions for extract-it",
  "homepage": "https://bamboocss.com",
  "license": "MIT",
  "author": "Gajus Kuizinas <gajus@gajus.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gajus/bamboocss.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --dts",
    "build-fast": "tsdown --dts=false",
    "dev": "pnpm build-fast --watch"
  },
  "dependencies": {
    "@bamboocss/is-valid-prop": "workspace:^",
    "@bamboocss/logger": "workspace:*",
    "@bamboocss/shared": "workspace:*",
    "@bamboocss/token-dictionary": "workspace:*",
    "@bamboocss/types": "workspace:*",
    "@csstools/postcss-cascade-layers": "6.0.0",
    "browserslist": "4.28.7",
    "css-tree": "3.2.1",
    "lodash.merge": "4.6.2",
    "outdent": "0.8.0",
    "postcss": "8.5.26",
    "postcss-minify-selectors": "8.0.3",
    "postcss-nested": "8.0.1",
    "postcss-normalize-whitespace": "8.0.2",
    "postcss-selector-parser": "7.1.5",
    "ts-pattern": "5.9.0"
  },
  "devDependencies": {
    "@types/css-tree": "2.3.11",
    "@types/lodash.merge": "4.6.9",
    "postcss-discard-duplicates": "8.0.2",
    "postcss-discard-empty": "8.0.2"
  }
}
