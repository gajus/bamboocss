{
  "name": "@bamboocss/eslint-plugin",
  "version": "1.51.6",
  "description": "ESLint plugin for Bamboo CSS",
  "homepage": "https://bamboocss.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gajus/bamboocss.git",
    "directory": "packages/eslint-plugin"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build-fast": "tsdown --dts=false",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@bamboocss/config": "workspace:*",
    "@bamboocss/generator": "workspace:*",
    "@bamboocss/shared": "workspace:*",
    "@typescript-eslint/scope-manager": "^8.43.0",
    "@typescript-eslint/utils": "^8.21.0",
    "micromatch": "^4.0.8",
    "synckit": "^0.9.0"
  },
  "devDependencies": {
    "@bamboocss/dev": "workspace:*",
    "@bamboocss/preset-bamboo": "workspace:*",
    "@bamboocss/preset-base": "workspace:*",
    "@bamboocss/types": "workspace:*",
    "@types/micromatch": "^4.0.10",
    "@typescript-eslint/rule-tester": "^8.43.0",
    "eslint": "^9.35.0",
    "multiline-ts": "^4.0.1",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "eslint": "*"
  }
}
