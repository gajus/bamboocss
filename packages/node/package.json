{
  "name": "@bamboocss/node",
  "version": "1.51.2",
  "description": "The core css bamboo library",
  "homepage": "https://bamboocss.com",
  "license": "MIT",
  "author": "Gajus Kuizinas <gajus@gajus.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gajus/bamboocss.git",
    "directory": "packages/node"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./static-compiler": {
      "source": "./src/static-compiler.ts",
      "import": {
        "types": "./dist/static-compiler.d.mts",
        "default": "./dist/static-compiler.mjs"
      },
      "require": {
        "types": "./dist/static-compiler.d.cts",
        "default": "./dist/static-compiler.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json src/index.ts src/static-compiler.ts --format=cjs,esm --shims --dts",
    "build-fast": "tsdown --dts=false --tsconfig tsconfig.build.json src/index.ts src/static-compiler.ts --format=cjs,esm --shims",
    "dev": "pnpm build-fast --watch"
  },
  "dependencies": {
    "@bamboocss/config": "workspace:*",
    "@bamboocss/core": "workspace:*",
    "@bamboocss/generator": "workspace:*",
    "@bamboocss/logger": "workspace:*",
    "@bamboocss/parser": "workspace:*",
    "@bamboocss/plugin-svelte": "workspace:*",
    "@bamboocss/plugin-vue": "workspace:*",
    "@bamboocss/reporter": "workspace:*",
    "@bamboocss/shared": "workspace:*",
    "@bamboocss/token-dictionary": "workspace:*",
    "@bamboocss/ts-ast": "workspace:*",
    "@bamboocss/types": "workspace:*",
    "chokidar": "5.0.0",
    "fast-glob": "3.3.3",
    "fs-extra": "11.3.2",
    "get-tsconfig": "^4.13.0",
    "lodash.merge": "4.6.2",
    "look-it-up": "2.1.0",
    "matcher": "6.0.0",
    "outdent": " ^0.8.0",
    "p-limit": "5.0.0",
    "package-manager-detector": "1.6.0",
    "perfect-debounce": "1.0.0",
    "picomatch": "4.0.5",
    "pkg-types": "2.3.0",
    "pluralize": "8.0.0",
    "ts-pattern": "5.9.0"
  },
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/picomatch": "4.0.2",
    "boxen": "8.0.1"
  }
}
