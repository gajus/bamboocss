{
  "name": "@bamboocss/plugin-astro",
  "version": "1.60.2",
  "description": "Bamboo CSS plugin for Astro components",
  "homepage": "https://bamboocss.com",
  "license": "MIT",
  "author": "Gajus Kuizinas <gajus@gajus.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gajus/bamboocss.git",
    "directory": "packages/plugin-astro"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format=esm,cjs --dts",
    "build-fast": "tsdown --dts=false src/index.ts --format=esm,cjs",
    "dev": "pnpm build-fast --watch"
  },
  "dependencies": {
    "@bamboocss/logger": "workspace:*",
    "@bamboocss/node": "workspace:*",
    "@bamboocss/types": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/compiler": "3.0.1",
    "@astrojs/compiler-rs": "0.5.1"
  },
  "peerDependencies": {
    "@astrojs/compiler": ">=2",
    "@astrojs/compiler-rs": ">=0.5"
  },
  "peerDependenciesMeta": {
    "@astrojs/compiler": {
      "optional": true
    },
    "@astrojs/compiler-rs": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
