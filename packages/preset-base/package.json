{
  "name": "@bamboocss/preset-base",
  "version": "1.53.0",
  "description": "The base preset for Bamboo CSS that contains the conditions and utilities",
  "homepage": "https://bamboocss.com",
  "license": "MIT",
  "author": "Gajus Kuizinas <gajus@gajus.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gajus/bamboocss.git",
    "directory": "packages/preset-base"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format=esm,cjs --dts",
    "build-fast": "tsdown --dts=false src/index.ts --format=esm,cjs",
    "dev": "pnpm build-fast --watch"
  },
  "dependencies": {
    "@bamboocss/types": "workspace:*"
  }
}
