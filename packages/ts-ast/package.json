{
  "name": "@bamboocss/ts-ast",
  "version": "1.50.1",
  "description": "The AST backend bamboo extracts through, on TypeScript 7's Go compiler",
  "homepage": "https://bamboocss.com",
  "license": "MIT",
  "author": "Gajus Kuizinas <gajus@gajus.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gajus/bamboocss.git",
    "directory": "packages/ts-ast"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format=esm,cjs --dts",
    "build-fast": "tsdown --dts=false src/index.ts --format=esm,cjs",
    "dev": "tsdown --dts=false src/index.ts --watch --format=esm,cjs"
  },
  "dependencies": {
    "@typescript/api": "npm:typescript@7.1.0-dev.20260826.1",
    "oxc-resolver": "^11.19.1"
  },
  "devDependencies": {
    "ts-morph": "28.0.0"
  }
}
