{
  "name": "@bamboocss/vite",
  "version": "1.51.2",
  "description": "Vite integration for Bamboo CSS",
  "homepage": "https://bamboocss.com",
  "license": "MIT",
  "author": "Gajus Kuizinas <gajus@gajus.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gajus/bamboocss.git",
    "directory": "packages/vite"
  },
  "files": [
    "client.d.ts",
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./client": "./client.d.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --dts",
    "build-fast": "tsdown --dts=false",
    "dev": "pnpm build-fast --watch"
  },
  "dependencies": {
    "@ampproject/remapping": "2.3.0",
    "@bamboocss/config": "workspace:*",
    "@bamboocss/core": "workspace:*",
    "@bamboocss/extractor": "workspace:*",
    "@bamboocss/logger": "workspace:*",
    "@bamboocss/node": "workspace:*",
    "@bamboocss/shared": "workspace:*",
    "@bamboocss/ts-ast": "workspace:*",
    "@bamboocss/types": "workspace:*",
    "magic-string": "0.30.21",
    "postcss": "8.5.26",
    "postcss-selector-parser": "7.1.5"
  },
  "devDependencies": {
    "@bamboocss/fixture": "workspace:*",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@typescript/api": "npm:typescript@7.1.0-dev.20260826.1",
    "vite": "7.2.6"
  },
  "peerDependencies": {
    "vite": ">=5"
  }
}
