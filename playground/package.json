{
  "name": "playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "css:codegen": "pnpm bamboo codegen --silent",
    "types:codegen": "tsx scripts/bundle-types.mts",
    "prepare": "pnpm db:generate && pnpm css:codegen",
    "build": "pnpm types:codegen && react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "oxlint .",
    "dev": "react-router dev",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@ark-ui/react": "5.18.3",
    "@bamboocss/config": "workspace:*",
    "@bamboocss/generator": "workspace:*",
    "@bamboocss/logger": "workspace:*",
    "@bamboocss/parser": "workspace:*",
    "@bamboocss/preset-bamboo": "workspace:*",
    "@bamboocss/preset-base": "workspace:*",
    "@monaco-editor/react": "4.6.0",
    "@prisma/client": "5.9.1",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@textea/json-viewer": "4.0.1",
    "isbot": "^5",
    "lightningcss-wasm": "1.30.2",
    "merge-anything": "6.0.6",
    "monaco-editor": "0.46.0",
    "monaco-editor-auto-typings": "0.4.6",
    "monaco-jsx-syntax-highlight": "1.2.0",
    "nanoid": "5.1.6",
    "os-browserify": "0.3.0",
    "outdent": " ^0.8.0",
    "path-browserify": "1.0.1",
    "prism-react-renderer": "2.3.1",
    "prisma": "5.9.1",
    "process": "0.11.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-live-runner": "1.0.7",
    "react-router": "8.3.0",
    "sucrase": "3.35.0",
    "usehooks-ts": "2.14.0",
    "util": "0.12.5",
    "zod": "3.25.1"
  },
  "devDependencies": {
    "@bamboocss/dev": "workspace:*",
    "@bamboocss/types": "workspace:*",
    "@bamboocss/vite": "workspace:*",
    "@react-router/dev": "8.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "dts-bundle-generator": "9.5.1",
    "oxlint": "1.66.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "browserslist": [
    "Chrome 118"
  ]
}
