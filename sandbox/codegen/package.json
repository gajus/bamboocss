{
  "name": "sandbox-codegen",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "test:up": "tsx ./cli.ts test -u",
    "test": "tsx ./cli.ts test && tsx ./cli.ts test -t",
    "prepare": "tsx ./cli.ts codegen",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "oxlint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bamboocss/dev": "workspace:^",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@bamboocss/vite": "workspace:*",
    "@builder.io/qwik": "1.17.2",
    "@preact/preset-vite": "2.10.2",
    "@solidjs/testing-library": "0.8.10",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/preact": "3.2.4",
    "@testing-library/react": "16.3.0",
    "@testing-library/vue": "8.1.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react-swc": "4.2.2",
    "@vitejs/plugin-vue": "6.0.2",
    "@vitejs/plugin-vue-jsx": "5.1.2",
    "cac": "6.7.14",
    "happy-dom": "20.0.11",
    "jsdom": "27.2.0",
    "oxlint": "1.66.0",
    "preact": "10.27.2",
    "solid-js": "1.9.10",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vite": "7.2.6",
    "vite-plugin-solid": "2.11.10",
    "vitest": "4.0.15",
    "vue": "3.5.25"
  }
}
