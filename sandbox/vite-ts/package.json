{
  "name": "sandbox-vite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "bamboo",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "css": "BAMBOO_DEBUG=ast:* bamboo",
    "css:gen": "BAMBOO_DEBUG=* bamboo codegen",
    "css:dev": "BAMBOO_DEBUG=file:* bamboo --watch",
    "explore": "source-map-explorer 'dist/assets/*.js' --no-border-checks",
    "analyze": "pnpm bamboo codegen --clean && ANALYZE=true vite build && pnpm explore",
    "visualize": "pnpm bamboo codegen --clean && vite-bundle-visualizer"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@bamboocss/dev": "workspace:*",
    "@bamboocss/vite": "workspace:*",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "source-map-explorer": "2.5.3",
    "typescript": "7.0.2",
    "vite": "7.2.6",
    "vite-bundle-visualizer": "1.2.1"
  }
}
