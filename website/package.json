{
  "name": "website",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "type": "module",
  "scripts": {
    "prepare": "bamboo codegen",
    "dev:content": "velite --watch",
    "dev:router": "react-router dev",
    "dev": "run-p dev:*",
    "build:content": "velite --clean",
    "build:og": "tsx --tsconfig scripts/tsconfig.json scripts/generate-og-images.tsx",
    "build:logo": "tsx --tsconfig scripts/tsconfig.json scripts/generate-logo-assets.tsx",
    "build:router": "react-router build",
    "//build": "Steps are named rather than globbed: og reads the velite collection and writes into public/, so it has to sit between the two.",
    "build": "run-s build:content build:og build:router",
    "prebuild": "pnpm --filter=../packages/** build",
    "check-links": "node scripts/check-links.mjs",
    "lint": "oxlint .",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@ark-ui/react": "5.18.3",
    "@bamboocss/preset-bamboo": "workspace:*",
    "@bamboocss/token-dictionary": "workspace:*",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "fuse.js": "^7.1.0",
    "isbot": "^5",
    "npm-run-all": "^4.1.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "5.5.0",
    "react-router": "^8.3.0",
    "scroll-into-view-if-needed": "3.1.0"
  },
  "devDependencies": {
    "@bamboocss/dev": "workspace:*",
    "@bamboocss/vite": "workspace:*",
    "@react-router/dev": "^8.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/rehype": "^3.19.0",
    "@shikijs/transformers": "^3.19.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.4",
    "oxlint": "1.66.0",
    "postcss": "8.5.26",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "satori": "^0.29.0",
    "shiki": "^3.19.0",
    "tsx": "4.20.6",
    "unist-util-visit": "^5.0.0",
    "velite": "0.3.0",
    "vite": "8.2.2"
  }
}
