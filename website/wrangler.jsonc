{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bamboocss",
  "compatibility_date": "2026-08-04",

  // Prerendered assets are served directly. Runtime SSR requires a Cloudflare
  // adapter and Worker entry point in addition to this assets binding.
  "assets": {
    "directory": "./build/client",
    "not_found_handling": "single-page-application",
  },
}
